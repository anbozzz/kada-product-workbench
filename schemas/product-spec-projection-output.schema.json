{
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "pages", "modules"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1" },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "version", "status", "description", "sourceRefs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["draft", "reviewing", "confirmed", "superseded"] },
        "description": { "type": ["string", "null"] },
        "sourceRefs": {
          "anyOf": [
            { "type": "array", "items": { "type": "string" } },
            { "type": "null" }
          ]
        }
      }
    },
    "pages": {
      "type": "array",
      "items": { "$ref": "#/$defs/page" }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "purpose", "scope", "journeys", "nodes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "scope": { "type": ["string", "null"] },
        "journeys": {
          "anyOf": [
            { "type": "array", "items": { "type": "string" } },
            { "type": "null" }
          ]
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/node" }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "responsibility", "parentPageId", "routeHints", "anchorHints"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "responsibility": { "type": ["string", "null"] },
        "parentPageId": {
          "anyOf": [
            { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]*$" },
            { "type": "null" }
          ]
        },
        "routeHints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "anchorHints": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "pageId",
        "status",
        "sourceKind",
        "surface",
        "statement",
        "anchorHints",
        "contentBlocks",
        "relations"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]*$" },
        "type": { "type": "string", "enum": ["SURFACE", "ACTION", "RULE", "STATE", "EVENT", "PERMISSION", "EXTERNAL", "AC", "TBD"] },
        "title": { "type": "string", "minLength": 1 },
        "pageId": {
          "anyOf": [
            { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]*$" },
            { "type": "null" }
          ]
        },
        "status": { "type": "string", "enum": ["draft", "reviewing", "confirmed", "superseded"] },
        "sourceKind": { "type": "string", "enum": ["observed-ui", "product-decision", "candidate", "formal-source", "simulation", "tbd"] },
        "surface": { "type": ["string", "null"] },
        "statement": { "type": ["string", "null"] },
        "anchorHints": { "type": "array", "items": { "type": "string" } },
        "contentBlocks": { "type": "array", "items": { "$ref": "#/$defs/contentBlock" } },
        "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } }
      }
    },
    "contentBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "content"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "content": { "type": "string", "minLength": 1 }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "targetId"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "targetId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
